🧪 Program 2: Binary Search
def binary_search(arr, key):
 low = 0
 high = len(arr) - 1
 while low <= high:
 mid = (low + high) // 2
 if arr[mid] == key:
 return mid
 elif arr[mid] < key:
 low = mid + 1
 else:
 high = mid - 1
 return -1
arr = [10, 20, 30, 40, 50]
key = 40
print("Index:", binary_search(arr, key))
